{
  "name": "sanity-plugin-i18n",
  "version": "2.0.1",
  "description": "Internationalized string/text/blockContent field types for Sanity Studio, with automatic translation via MyMemory or Azure Translator.",
  "keywords": [
    "i18n",
    "internationalization",
    "l10n",
    "sanity",
    "sanity-plugin",
    "translation"
  ],
  "homepage": "https://www.sanity.io/plugins/sanity-plugin-i18n",
  "bugs": {
    "url": "https://github.com/namecoder1/sanity-plugin-i18n/issues"
  },
  "license": "MIT",
  "author": "tobi <bartolomei.private@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namecoder1/sanity-plugin-i18n.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./core": "./dist/core.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@portabletext/editor": "^8.0.2",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^12.3.0",
    "@sanity/plugin-kit": "^10.0.8",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.10.1",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@portabletext/editor": "^7.11 || ^8",
    "react": "^19.2",
    "sanity": "^6.10.0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "tsconfig": false
    }
  }
}
